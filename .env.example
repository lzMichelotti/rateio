# Copy to .env and adjust. .env is gitignored; this template is committed.
# Local development only: these credentials never leave your machine.

POSTGRES_USER=rateio
POSTGRES_PASSWORD=rateio_dev
POSTGRES_DB=rateio

# Host port for the dev database. Change it if 5432 is already taken.
POSTGRES_PORT=5432

# Connection string used by the migration runner and the tests.
# Keep user, password, port and database in sync with the values above.
DATABASE_URL=postgresql://rateio:rateio_dev@127.0.0.1:5432/rateio
