{
  // Node runs the .ts files itself by stripping types, which does no type
  // checking at all: tsc only checks, never emits.
  // https://nodejs.org/api/typescript.html
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "nodenext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // TypeScript 7 defaults types to []: without this, process and Buffer
    // are unknown.
    "types": ["node"]
  },
  "include": ["src", "test"]
}
