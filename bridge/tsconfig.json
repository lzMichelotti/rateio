{
  // Node runs the .ts files itself by stripping types, which does no type
  // checking at all: tsc only checks, never emits.
  // https://nodejs.org/api/typescript.html
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "nodenext",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // TypeScript 7 defaults types to []: without this, process and Buffer
    // are unknown.
    "types": ["node"],
    // Baileys' own .d.ts files do not pass TypeScript 7 (extensionless
    // imports, a missing type, no types for ws). We cannot fix the library;
    // our code is still checked against its types.
    // https://www.typescriptlang.org/tsconfig/#skipLibCheck
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
