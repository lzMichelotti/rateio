    "node": ">=26 <27"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@whiskeysockets/baileys": false,
    "protobufjs": false
  }
}
